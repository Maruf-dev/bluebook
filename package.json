{
  "name": "examdesk",
  "productName": "ExamDesk",
  "version": "1.0.0",
  "description": "A professional digital SAT practice-testing desktop application",
  "main": "dist/electron/main.js",
  "type": "module",
  "author": "ExamDesk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maruf-dev/bluebook.git"
  },
  "bugs": {
    "url": "https://github.com/Maruf-dev/bluebook/issues"
  },
  "homepage": "https://github.com/Maruf-dev/bluebook#readme",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron dist/electron/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "better-sqlite3": "^11.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.400.0",
    "mathlive": "^0.91.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.examdesk.desktop",
    "productName": "ExamDesk",
    "compression": "maximum",
    "copyright": "Copyright \u00a9 2026 ExamDesk",
    "directories": {
      "output": "release",
      "app": "dist"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist/electron/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.png",
      "publisherName": "ExamDesk"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExamDesk",
      "displayLanguageSelector": true
    },
    "publish": null
  }
}