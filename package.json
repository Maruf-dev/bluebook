{
  "name": "examdesk",
  "productName": "ExamDesk",
  "version": "1.0.0",
  "description": "A professional digital SAT practice-testing desktop application",
  "main": "dist/electron/main/main.js",
  "type": "module",
  "author": "ExamDesk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maruf-dev/bluebook.git"
  },
  "bugs": {
    "url": "https://github.com/Maruf-dev/bluebook/issues"
  },
  "homepage": "https://github.com/Maruf-dev/bluebook#readme",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && wait-on tcp:5173 && electron . --dev",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:main": "tsc -p tsconfig.main.json && node scripts/write-cjs-package.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "katex": "^0.16.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.examdesk.desktop",
    "productName": "ExamDesk",
    "compression": "maximum",
    "copyright": "Copyright © 2026 ExamDesk",
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.png",
      "publisherName": "ExamDesk"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExamDesk",
      "displayLanguageSelector": true,
      "artifactName": "${productName}-Setup-${arch}.${ext}"
    },
    "publish": null,
    "directories": {
      "output": "release"
    }
  }
}
